{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation create response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "correlationId",
    "operationId",
    "state",
    "stateRevision",
    "expiresAt",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-create-response-v1"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "state": {
      "const": "Completed"
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "result": {
      "$ref": "provider-outcome-v1.schema.json"
    }
  }
}
