{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation cleanup unresolved v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "unresolvedId",
    "manifestId",
    "receiptId",
    "entryId",
    "correlationId",
    "failureClass",
    "recordedAt",
    "nextAction",
    "publicMessageCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-cleanup-unresolved-v1"
    },
    "unresolvedId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "failureClass": {
      "enum": [
        "BranchRace",
        "RevisionConflict",
        "DigestConflict",
        "InvalidActiveState",
        "TemporaryFailure"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "nextAction": {
      "enum": [
        "Recompile",
        "HumanReview",
        "RetryReconcile",
        "RetryDelete"
      ]
    },
    "publicMessageCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    }
  }
}
