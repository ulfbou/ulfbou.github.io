{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation tombstone event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "correlationId",
    "operationId",
    "capability",
    "providerAlias",
    "terminalState",
    "reasonCode",
    "expectedStateRevision",
    "canonicalRepresentation",
    "expectedStateSha256",
    "terminatedAt",
    "producer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-tombstone-event-v1"
    },
    "eventId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "capability": {
      "const": "architecture-scenario-classification-v1"
    },
    "providerAlias": {
      "const": "google-gemini-prototype"
    },
    "terminalState": {
      "enum": [
        "Completed",
        "Cancelled",
        "Revoked",
        "Expired",
        "Invalid",
        "FailedTerminal",
        "Superseded"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{2,63}$"
    },
    "expectedStateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "canonicalRepresentation": {
      "const": "correlation-state-canonical-json-v1"
    },
    "expectedStateSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "producer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Tombstone event producer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alias"
      ],
      "properties": {
        "kind": {
          "const": "GitHubApp"
        },
        "alias": {
          "const": "correlation-tombstone-producer-v1"
        }
      }
    }
  }
}
