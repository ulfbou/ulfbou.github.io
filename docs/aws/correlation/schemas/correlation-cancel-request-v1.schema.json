{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation cancel request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "correlationId",
    "operationId",
    "expectedStateRevision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-cancel-request-v1"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "expectedStateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
