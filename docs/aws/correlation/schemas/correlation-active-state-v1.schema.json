{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation active state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "correlationId",
    "operationId",
    "capability",
    "providerAlias",
    "state",
    "stateRevision",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "attempt",
    "maximumAttempts",
    "requestId",
    "expectedResultMode",
    "resultTarget",
    "previousStateSha256",
    "canonicalRepresentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-active-state-v1"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "capability": {
      "const": "architecture-scenario-classification-v1"
    },
    "providerAlias": {
      "const": "google-gemini-prototype"
    },
    "state": {
      "enum": [
        "Created",
        "Dispatching",
        "AwaitingProvider",
        "ResultReceived",
        "Completed",
        "Cancelled",
        "Revoked",
        "Expired",
        "Invalid",
        "FailedTerminal",
        "Superseded"
      ]
    },
    "stateRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "maximumAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
    },
    "expectedResultMode": {
      "const": "Synchronous"
    },
    "resultTarget": {
      "const": "browser-active-interaction-v1"
    },
    "previousStateSha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "string",
          "const": "none"
        }
      ]
    },
    "canonicalRepresentation": {
      "const": "correlation-state-canonical-json-v1"
    }
  }
}
