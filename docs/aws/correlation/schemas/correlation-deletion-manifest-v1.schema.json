{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation deletion manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "repository",
    "runtimeBranch",
    "runtimeCommit",
    "createdAt",
    "expiresAt",
    "policyVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-deletion-manifest-v1"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "const": "ulfbou/ulfbou.github.io"
    },
    "runtimeBranch": {
      "const": "correlation-runtime"
    },
    "runtimeCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "policyVersion": {
      "const": "cleanup-policy-v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Deletion manifest entry v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entryId",
          "tombstonePath",
          "tombstoneSha256",
          "correlationId",
          "expectedStateRevision",
          "expectedStateSha256"
        ],
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
          },
          "tombstonePath": {
            "type": "string",
            "pattern": "^correlation-runtime/tombstones/v1/[a-z0-9/_-]+\\.json$",
            "maxLength": 240
          },
          "tombstoneSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "correlationId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
          },
          "expectedStateRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "expectedStateSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
