{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Correlation cleanup status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "receiptId",
    "runtimeCommit",
    "reconciledAt",
    "outcome",
    "processedEntryIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": "correlation-cleanup-status-v1"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtimeCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reconciledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "outcome": {
      "enum": [
        "Reconciled",
        "PartiallyReconciled"
      ]
    },
    "processedEntryIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{7,127}$"
      }
    }
  }
}
