<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Ulfbou.Portfolio.Core/Ulfbou.Portfolio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../src/content/**/*.json"
             Link="content/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/wwwroot/data/portfolio.json"
             Link="portfolio.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/wwwroot/data/portfolio.json"
             Link="legacy/portfolio.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/wwwroot/data/generated/portfolio.json"
             Link="generated/portfolio.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/Components/StoryBlockView.razor"
             Link="repository/StoryBlockView.razor"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/Pages/Home.razor"
             Link="repository/Home.razor"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/wwwroot/css/story-blocks.css"
             Link="repository/story-blocks.css"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Ulfbou.Site/wwwroot/index.html"
             Link="repository/index.html"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
