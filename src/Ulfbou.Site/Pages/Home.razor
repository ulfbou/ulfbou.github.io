@page "/"
@inject PortfolioService Portfolio

<PageTitle>Ulf Bourelius · Selected Systems</PageTitle>

@if (isLoading)
{
    <main id="main-content"><p class="load-state" role="status">Assembling the portfolio…</p></main>
}
else if (loadError is not null)
{
    <main id="main-content" class="load-state" role="alert">
        <h1>The portfolio could not be loaded.</h1>
        <p>@loadError</p>
        <button type="button" @onclick="LoadAsync">Try again</button>
    </main>
}
else if (data is null || data.Projects.Count == 0)
{
    <main id="main-content" class="load-state">
        <h1>No portfolio projects are available.</h1>
        <p>The representative collection is currently empty.</p>
    </main>
}
else
{
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="masthead">
        <a class="identity" href="#top">
            <span class="monogram" aria-hidden="true">UB</span>
            <span>@data.Profile.Name<small>Representative systems · 2026</small></span>
        </a>
        <nav aria-label="Page navigation">
            <a href="#work">Work</a>
            <a href="#about">Approach</a>
            @foreach (var link in data.Profile.Links)
            {
                <a href="@link.Url">@link.Label</a>
            }
        </nav>
    </header>

    <main id="main-content">
        <section class="hero" id="top" aria-labelledby="portfolio-title">
            <div class="hero-copy">
                <p class="overline">Educator · developer · systems thinker</p>
                <h1 id="portfolio-title">@data.Profile.Signal</h1>
                <p class="intro">@data.Profile.Introduction</p>
                <p class="representative-note">Representative prototype content pending final publication approval.</p>
            </div>

            <div class="orbit" aria-label="Portfolio themes">
                <span class="orbit-core" aria-hidden="true">UB</span>
                @for (var i = 0; i < data.Facets.Count; i++)
                {
                    var item = data.Facets[i];
                    <button type="button"
                            class="orbit-item @($"orbit-{i}")"
                            aria-pressed="@(facet == item)"
                            @onclick="() => SelectFacet(item)">
                        @item
                    </button>
                }
            </div>

            <a class="scroll-cue" href="#work">Follow the threads <span aria-hidden="true">↓</span></a>
        </section>

        <section class="work" id="work" aria-labelledby="work-title">
            <div class="section-title">
                <p class="overline">Selected work</p>
                <h2 id="work-title">Ideas made inspectable.</h2>
                <p>Choose a thread. The same projects reorganize around what you want to inspect.</p>
            </div>

            <div class="facet-bar" aria-label="Filter projects">
                <button type="button"
                        class="@(facet is null ? "active" : null)"
                        aria-pressed="@(facet is null)"
                        @onclick="ClearFacet">
                    All
                </button>
                @foreach (var item in data.Facets)
                {
                    <button type="button"
                            class="@(facet == item ? "active" : null)"
                            aria-pressed="@(facet == item)"
                            @onclick="() => SelectFacet(item)">
                        @item
                    </button>
                }
            </div>

            @if (!VisibleProjects.Any())
            {
                <p class="empty-state" role="status">No projects match this facet.</p>
            }
            else
            {
                <div class="project-stack">
                    @foreach (var project in data.Projects)
                    {
                        var detailId = $"project-{project.Id}";
                        var isVisible = ProjectMatchesFacet(project);
                        var isOpen = openId == project.Id;

                        <article class="project @(!isVisible ? "filtered-out" : null)"
                                 style="@($"--accent:{project.Accent}")">
                            <h3 class="project-heading">
                                <button type="button"
                                        class="project-summary"
                                        aria-expanded="@isOpen"
                                        aria-controls="@detailId"
                                        @onclick="() => Toggle(project.Id)">
                                    <span class="project-index">@ProjectNumber(project)</span>
                                    <span class="project-name">
                                        <small>@project.Status</small>
                                        <strong>@project.Title</strong>
                                        <em>@project.Proposition</em>
                                    </span>
                                    <span class="project-tech">@string.Join(" · ", project.Technologies.Take(3))</span>
                                    <span class="toggle">@(isOpen ? "Close" : "Explore")</span>
                                </button>
                            </h3>

                            <div class="project-detail @(!isOpen ? "collapsed-detail" : null)"
                                 id="@detailId"
                                 aria-hidden="@(!isOpen)">
                                @if (project.Blocks.Count > 0)
                                {
                                    <div class="story-blocks">
                                        @foreach (var block in project.Blocks.OrderBy(item => item.Order))
                                        {
                                            <StoryBlockView Block="@block" />
                                        }
                                    </div>

                                    <div class="narrative compatibility-detail">
                                        <h4>My contribution</h4>
                                        <p>@project.Contribution</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="narrative">
                                        <p class="overline">The story</p>
                                        <p class="large-copy">@project.Story</p>

                                        <div class="two-up">
                                            <div>
                                                <h4>My contribution</h4>
                                                <p>@project.Contribution</p>
                                            </div>
                                            <div>
                                                <h4>Reflection</h4>
                                                <p>@project.Reflection</p>
                                            </div>
                                        </div>

                                        <h4>Limitations</h4>
                                        <ul>
                                            @foreach (var limitation in project.Limitations)
                                            {
                                                <li>@limitation</li>
                                            }
                                        </ul>
                                    </div>

                                    <div class="artifact">
                                        <div class="artifact-bar" aria-hidden="true">
                                            <span></span>
                                            <span></span>
                                            <span></span>
                                            <b>@project.Demo.Caption</b>
                                        </div>
                                        <pre aria-label="@project.Demo.Caption"><code>@string.Join("\n", project.Demo.Lines)</code></pre>
                                        <div class="proof-grid" aria-label="Representative evidence pointers">
                                            @foreach (var proof in project.Proof)
                                            {
                                                <div>
                                                    <small>@proof.Label</small>
                                                    <code>@proof.Value</code>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="about" id="about" aria-labelledby="about-title">
            <p class="overline">How I work</p>
            <div>
                <h2 id="about-title">Human authority.<br />Explicit boundaries.<br />Evidence that can be followed.</h2>
                <p>@data.Profile.Direction</p>
            </div>
        </section>
    </main>

    <footer>
        <span>@data.Profile.Name · Stockholm</span>
        <span>Approved content loaded from <code>data/generated/portfolio.json</code>.</span>
        <a href="#top">Back to top ↑</a>
    </footer>
}

@code {
    private PortfolioData? data;
    private string? facet;
    private string? openId;
    private bool isLoading = true;
    private string? loadError;

    private IEnumerable<Project> VisibleProjects =>
        data is null
            ? []
            : data.Projects.Where(ProjectMatchesFacet);

    private bool ProjectMatchesFacet(Project project) =>
        facet is null
        || project.Facets.Contains(
            facet,
            StringComparer.Ordinal);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            data = await Portfolio.LoadAsync();
        }
        catch
        {
            data = null;
            loadError = "Check the data source and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFacet()
    {
        facet = null;
        openId = null;
    }

    private void SelectFacet(string value)
    {
        facet = value;
        openId = null;
    }

    private void Toggle(string id) =>
        openId = openId == id ? null : id;

    private string ProjectNumber(Project project) =>
        data is null
            ? "00"
            : (data.Projects
                .ToList()
                .FindIndex(item => item.Id == project.Id) + 1)
                .ToString("00");
}
