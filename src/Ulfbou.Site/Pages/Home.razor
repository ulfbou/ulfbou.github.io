@page "/"
@inject PortfolioService Portfolio

<PageTitle>Ulf Bourelius · Selected Systems</PageTitle>

@if (data is null)
{
    <p class="load-state">Assembling the portfolio…</p>
}
else
{
    <main>
        <header class="masthead">
            #top
                <span class="monogram">UB</span>
                <span>@data.Profile.Name<small>Selected systems · 2026</small></span>
            </a>
            <nav aria-label="Page navigation">
                #workWork</a>
                #aboutApproach</a>
                @foreach (var link in data.Profile.Links)
                {
                    @link.Url@link.Label</a>
                }
            </nav>
        </header>

        <section class="hero" id="top">
            <div class="hero-copy">
                <p class="overline">Educator · developer · systems thinker</p>
                <h1>@data.Profile.Signal</h1>
                <p class="intro">@data.Profile.Introduction</p>
            </div>

            <div class="orbit" aria-label="Portfolio themes">
                <span class="orbit-core">UB</span>
                @for (var i = 0; i < data.Facets.Count; i++)
                {
                    var facetIndex = i;
                    var orbitFacet = data.Facets[facetIndex];

                    <button class="orbit-item @($"orbit-{facetIndex}")"
                            @onclick="() => SelectFacet(orbitFacet)">
                        @orbitFacet
                    </button>
                }
            </div>

            #workFollow the threads <span>↓</span></a>
        </section>

        <section class="work" id="work">
            <div class="section-title">
                <p class="overline">Selected work</p>
                <h2>Ideas made inspectable.</h2>
                <p>Choose a thread. The same projects reorganize around what you want to inspect.</p>
            </div>

            <div class="facet-bar" aria-label="Filter projects">
                <button class="@(facet is null ? "active" : null)"
                        @onclick="() => facet = null">
                    All
                </button>

                @foreach (var item in data.Facets)
                {
                    var selectedFacet = item;

                    <button class="@(facet == selectedFacet ? "active" : null)"
                            @onclick="() => SelectFacet(selectedFacet)">
                        @selectedFacet
                    </button>
                }
            </div>

            <div class="project-stack">
                @foreach (var project in VisibleProjects)
                {
                    <article class="project" style="@($"--accent:{project.Accent}")">
                        <button class="project-summary"
                                @onclick="() => Toggle(project.Id)"
                                aria-expanded="@(openId == project.Id)">
                            <span class="project-index">@ProjectNumber(project)</span>

                            <span class="project-name">
                                <small>@project.Status</small>
                                <strong>@project.Title</strong>
                                <em>@project.Proposition</em>
                            </span>

                            <span class="project-tech">
                                @string.Join(" · ", project.Technologies.Take(3))
                            </span>

                            <span class="toggle">
                                @(openId == project.Id ? "Close" : "Explore")
                            </span>
                        </button>

                        @if (openId == project.Id)
                        {
                            <div class="project-detail">
                                <div class="narrative">
                                    <p class="overline">The proposition</p>
                                    <p class="large-copy">@project.Story</p>

                                    <div class="two-up">
                                        <div>
                                            <h3>My contribution</h3>
                                            <p>@project.Contribution</p>
                                        </div>

                                        <div>
                                            <h3>What it taught me</h3>
                                            <p>@project.Reflection</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="artifact">
                                    <div class="artifact-bar">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <b>@project.Demo.Caption</b>
                                    </div>

                                    <pre aria-label="@project.Demo.Caption"><code>@string.Join("\n", project.Demo.Lines)</code></pre>

                                    <div class="proof-grid">
                                        @foreach (var proof in project.Proof)
                                        {
                                            <div>
                                                <small>@proof.Label</small>
                                                <code>@proof.Value</code>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="about" id="about">
            <p class="overline">How I work</p>

            <div>
                <h2>
                    Human authority.<br />
                    Explicit boundaries.<br />
                    Evidence that can be followed.
                </h2>

                <p>@data.Profile.Direction</p>
            </div>
        </section>

        <footer>
            <span>@data.Profile.Name · Stockholm</span>
            <span>Content is loaded from <code>portfolio.json</code>.</span>
            #topBack to top ↑</a>
        </footer>
    </main>
}

@code {
    private PortfolioData? data;
    private string? facet;
    private string? openId;

    private IEnumerable<Project> VisibleProjects =>
        data is null
            ? []
            : facet is null
                ? data.Projects
                : data.Projects.Where(project => project.Facets.Contains(facet));

    protected override async Task OnInitializedAsync()
    {
        data = await Portfolio.LoadAsync();
    }

    private void SelectFacet(string value)
    {
        facet = value;
        openId = null;
    }

    private void Toggle(string id)
    {
        openId = openId == id ? null : id;
    }

    private string ProjectNumber(Project project)
    {
        if (data is null)
        {
            return "00";
        }

        var index = data.Projects
            .Select((item, position) => new { item.Id, Position = position })
            .First(item => item.Id == project.Id)
            .Position;

        return (index + 1).ToString("00");
    }
}
